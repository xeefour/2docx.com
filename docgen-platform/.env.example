# ─────────────────────────────────────────────────────────────
#  ค่าเฉพาะตอน dev บน host — ไฟล์นี้คือ "ส่วนที่ต่าง" ไม่ใช่ทั้งระบบ
#
#  ค่ากลาง (secret · Casdoor · S3 · NATS) ย้ายไปไฟล์กลางแล้ว:
#     ../dokploy-infra/.env        (สร้างจาก ../dokploy-infra/.env.example)
#
#  เหตุผลที่ต้องแยก: docker compose อ่านค่าไว้ในรูปแบบ ${VAR} จาก .env
#  ที่อยู่**โฟลเดอร์เดียวกับไฟล์ compose** เท่านั้น ถ้าย้ายไฟล์ compose
#  ไปที่อื่น ค่ากลางทั้งหมดจะกลายเป็นค่าว่างและ container จะ crash ตอน boot
#
#  dev อ่านสองไฟล์เรียงกัน (ไฟล์หลังทับไฟล์หน้า — ยืนยันแล้วว่า Node ให้หลังทับหน้า):
#    node --env-file=../../dokploy-infra/.env --env-file=../../.env ...
#
#  ค่าในไฟล์นี้คือ URL ที่ชี้เข้า host เอง ซึ่ง**ต่างจาก**ค่าใน container
#  ที่ชี้ชื่อ service บนเครือข่าย Docker (ค่านั้น hardcode ไว้ในไฟล์ compose แล้ว)
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────
# ⚠️ ผูก 127.0.0.1 เท่านั้น — ถ้าเป็น 0.0.0.0 ใครใน LAN และใครใน Tailscale
#    ก็ยิงเข้าได้ (วัดจริงแล้วตอบ 200 ทั้งสองทาง)
#    ใน container ค่านี้ถูกบังคับเป็น 0.0.0.0 เพื่อให้ gateway ยิงเข้าได้
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4001

# เข้าเว็บด้วย localhost ไม่ใช่ 127.0.0.1 — cookie ของ Casdoor ผูกกับ host
CORS_ORIGINS=http://localhost:8090,https://your-machine.tailnet.ts.net

# ── MongoDB ──────────────────────────────────────────────────
# ใน container ค่านี้ชี้ชื่อ service (mongo-1, mongo-2, mongo-3) + replicaSet=rs0
# บน host ต้องใช้ port ที่ publish ออกมา และใช้ directConnection
# เพราะชื่อ `mongo-1` resolve ไม่ได้นอกเครือข่าย Docker
MONGO_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/app?directConnection=true&authSource=admin
MONGO_INIT_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/admin?directConnection=true&authSource=admin
MONGO_PRIMARY_CANDIDATES=127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019

# ── Valkey (cache) ───────────────────────────────────────────
VALKEY_URL=redis://:CHANGE_ME@localhost:16379

# ── NATS JetStream (คิวงาน) ─────────────────────────────────
NATS_URL=nats://app:CHANGE_ME@localhost:4222

# ── docserver (เรนเดอร์ PDF) ────────────────────────────────
# ⚠️ docserver ไม่มีพอร์ตผูกไว้แล้ว บน host จะยิงค่านี้ไม่ถึงจริง
#    และชื่อ `docserver` ก็ resolve ไม่ได้บน host เช่นกัน
#    (Docker Desktop ใช้ WSL2 ซึ่งแยก network namespace)
#    ใช้ได้เฉพาะจากในเครือข่าย Docker เท่านั้น
#    ถ้าต้องทดสอบส่วนที่ต้องเรนเดอร์ ให้ใช้ gateway ที่ http://127.0.0.1:8090
DOCSERVER_URL=http://127.0.0.1:4000

# ── RustFS (เก็บไฟล์) ────────────────────────────────────────
# ใน container ชี้ชื่อ service (rustfs:9000) · บน host ใช้ port ที่ publish
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

# ── Session ───────────────────────────────────────────────────
# เว็บที่รันด้วย http ในเครื่องตัวเอง ต้องเป็น false
# ตอนขึ้นโดเมนจริง (https) ต้องเป็น true
SESSION_COOKIE_SECURE=false

# ── Rate limit ────────────────────────────────────────────────
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# ── อีเมล (SMTP) ─────────────────────────────────────────
# ⚠️ ยังไม่ได้ตั้งค่า SMTP จริง — ปุ่ม "เชิญด้วยอีเมล" จะตอบ 200 + emailed:false
#    ดูค่าที่ต้องใส่ใน README.md → หัวข้อ SMTP
SMTP_FROM=2docx.com <no-reply@2docx.com>

# ── AI ช่วยกรอกฟอร์มใน Studio ──────────────────────────────
# provider=mock = ตอบคำแนะนำจากกฎที่เขียนไว้ ไม่ยิง API จริง (ใช้ตอน dev)
# เปลี่ยนเป็นชื่อผู้ให้บริการจริงเมื่อพร้อมใส่คีย์
LLM_PROVIDER=mock
LLM_MODEL=MiniMax-M3
LLM_THINKING=disabled
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=120000

# ============================================================
#  Docgen Platform — ตัวอย่างค่าทั้งหมด
#  copy เป็น .env แล้วแก้ตามจริง — ห้าม commit
# ============================================================

NODE_ENV=development
LOG_LEVEL=info

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# ใส่ domain ที่ deploy จริง คั่นด้วย comma (สำหรับ CORS)
# ถ้าเข้าผ่าน Tailscale Serve ต้องเพิ่ม origin ของมันด้วย
CORS_ORIGINS=http://localhost:3000,https://your-machine.tailXXXX.ts.net

# ── MongoDB ──────────────────────────────────────────────────
# ⚠️ ต้องเป็น replica set (rs0) ไม่ใช่ standalone — อยู่ใน stack ../dokploy-infra แล้ว
#    ตอนรันบน host ตรง ๆ (npm run dev) ใช้พอร์ตที่ map ออกมา + directConnection
MONGO_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/app?directConnection=true&authSource=admin
MONGO_INIT_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/admin?directConnection=true
MONGO_DB=app
# พอร์ต MongoDB ทั้งหมดที่ publish ออกมา — ใช้หา primary จริงก่อนต่อ
# เว้นว่างไว้ถ้ารันใน Docker (ใช้ชื่อ service อยู่แล้ว driver จัดการเอง)
# ⚠️ ต้องใส่ครบทุกพอร์ต ไม่งั้นจะชี้ไป node ที่เป็น SECONDARY แล้วได้ "not primary"
MONGO_PRIMARY_CANDIDATES=127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019
# ใช้ตอน compose สร้าง connection string ให้ API/worker
MONGO_PASSWORD=CHANGE_ME

# ── Valkey (cache) ───────────────────────────────────────────
# ⚠️ เก็บทั้ง URL (ตอนรันบน host) และ password แยก (ตอนรันใน docker compose)
VALKEY_URL=redis://:CHANGE_ME@localhost:6379
VALKEY_PASSWORD=CHANGE_ME

# ── NATS JetStream (คิวงาน) ─────────────────────────────────
# ⚠️ nats.js 2.x ไม่อ่าน user:pass จาก URL — ต้องมีใน URL ให้ครบ
#    (packages/shared/src/env.ts จะแยกมาเป็น option ให้เอง)
NATS_URL=nats://app:CHANGE_ME@localhost:4222
NATS_PASSWORD=CHANGE_ME
# stream ต้องเป็นชื่อที่มีอยู่แล้วใน NATS ของ dokploy-infra (= JOBS, จับ jobs.>)
# ถ้าจะสร้าง stream ใหม่ เรื่องนี้คือ NATS ไม่ให้สอง stream ใช้ subject ซ้อนกัน
NATS_STREAM=JOBS
NATS_SUBJECT=jobs.render

# ── Casdoor SSO (OIDC) ─────────────────────────────────────────
# discovery: <issuer>/.well-known/openid-configuration
CASDOOR_ISSUER=https://auth.2docx.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# ⚠️ ต้องตรงกับที่ลงทะเบียนไว้ใน Casdoor ทุกตัวอักษร
#    ใช้ localhost ไม่ใช่ 127.0.0.1 — browser มองสองอย่างนี้เป็นคนละ site
#    ถ้าใช้คนละแบบ cookie SameSite=Lax จะไม่ถูกส่งกลับมา
CASDOOR_REDIRECT_URI=http://localhost:4001/auth/callback
CASDOOR_SCOPES=openid profile email
# หลัง login สำเร็จจะพาไปที่นี่ (origin นี้เป็น allowlist กัน open redirect)
# ⚠️ ตอนนี้ยังไม่มี apps/web → ชี้ไป Swagger UI ของ API ไปก่อน (cookie เป็น
#    same origin จึงใช้ได้ปกติ) พอสร้าง Next.js เสร็จค่อยเปลี่ยนเป็น
#    http://localhost:3000
AUTH_SUCCESS_REDIRECT=http://localhost:3000/studio

# ── Session ───────────────────────────────────────────────────
SESSION_COOKIE_NAME=docgen_session
SESSION_TTL=86400
# true เมื่อเสิร์ฟผ่าน https (Tailscale Serve / Cloudflare) — browser
# จะไม่ยอมรับ cookie ที่ไม่มี Secure เมื่ออยู่บน https
SESSION_COOKIE_SECURE=false

# ── Rate limit ────────────────────────────────────────────────
# จำนวน request ต่อ IP ต่อหน้าต่างเวลา
# ⚠️ ค่าเดิม 100/นาที น้อยเกินไปสำหรับ Studio — เปิดหน้าเดียวยิงราว 6 request
#    ผู้ใช้ที่รีเฟรชสัก 5 ครั้งก็โดน 429 ทั้งที่ไม่ได้ทำอะไรผิด
# ตั้งเป็น 0 = ปิด (เหมาะกับเครื่องที่อยู่ใน tailnet ส่วนตัว)
# /api/health ถูกยกเว้นเสมอ ไม่กินโควตาของผู้ใช้
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# ── RustFS (เก็บไฟล์) ────────────────────────────────────────
# ⚠️ path-style บังคับ — RustFS ไม่รองรับ virtual-hosted โดยค่าเริ่มต้น
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true
# endpoint ที่ client ภายนอกเข้าถึงได้ — ใช้เฉพาะตอนออก presigned URL
# เว้นว่างไว้ถ้าเรียกจากเครื่องเดียวกัน (ค่าเริ่มต้น = ใช้ S3_ENDPOINT)
# ⚠️ ถ้าเข้าผ่าน Tailscale Serve / Cloudflare Tunnel ต้องตั้ง
#    ไม่งั้น URL จะชี้ localhost ของ client แทนที่จะเป็นเครื่องเรา
# S3_PUBLIC_ENDPOINT=https://your-machine.tailXXXX.ts.net:8443

# ── docserver (เรนเดอร์ PDF) ────────────────────────────────
DOCSERVER_URL=http://localhost:4000
DOCSERVER_API_KEY=carbon-ce
# Carbone 5 เป็น async — ต้องยิง 2 รอบ (POST ได้ renderId แล้วค่อย GET)
DOCSERVER_TIMEOUT_MS=300000

# ชื่อที่เขียนทับลง metadata ของไฟล์ที่เรนเดอร์ออกมา
# ไม่ทำอะไร = PDF จะขึ้น "LibreOffice 26.2.4" และ DOCX จะขึ้น "Microsoft Office Word"
# รวมถึงชื่อผู้สร้างที่รั่วมาจาก .docx ต้นแบบ (เคยเจอชื่อจริงของคนทำแม่แบบปนอยู่)
OUTPUT_BRAND=2docx.com

# ── AI ช่วยกรอกฟอร์มใน Studio ──────────────────────────────
# minimax = MiniMax · openai = OpenAI-compatible ทั่วไป · mock = ไม่ออกเน็ต
# ⚠️ ค่าเริ่มต้นคือ mock เพื่อให้ระบบทำงานได้โดยไม่ต้องมี key
LLM_PROVIDER=mock

# key ของผู้ให้บริการ — เว้นว่าง = ยังใช้ AI ไม่ได้ (API จะตอบ 503 พร้อมคำอธิบาย)
# MiniMax (นอกประเทศ): https://platform.minimax.io  →  กุญแจอยู่ในหน้า API Keys
# LLM_API_KEY=

# โมเดล · MiniMax-M3 มี 1M context · M2.7 เร็วกว่าเล็กน้อย
LLM_MODEL=MiniMax-M3

# base URL แบบ OpenAI-compatible · เว้นว่าง = ใช้ค่าเริ่มต้นของ provider
# MiniMax (นอกประเทศ) = https://api.minimax.io/v1
# MiniMax (จีน)        = https://api.minimaxi.com/v1
# LLM_BASE_URL=

# MiniMax M3 "คิด" โดยค่าเริ่มต้ว → ช้ากว่าหลายเท่าเมื่อแค่เติมค่าในฟอร์ม
# disabled = ได้คำตอบทันที (ค่าเริ่มต้น) · auto = เปิดการคิด
LLM_THINKING=disabled

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=120000

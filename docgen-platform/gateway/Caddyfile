# ─────────────────────────────────────────────────────────────
#  ทางเข้าเดียวของทั้งระบบ (reverse proxy)
#
#  เป้าหมาย: ไม่ต้องเปิดพอร์ตออกจากเครื่องเลย ผู้ใช้เข้าผ่านโดเมนเดียว
#    แล้วแยกบริการตาม prefix ของ path
#
#  ทำไมต้องมี: ก่อนหน้านี้ API เปิดที่ 0.0.0.0:4001 และเว็บที่ :3000
#    → ใครใน LAN ก็เรียกได้ ตอนนี้ปิดพอร์ตเหล่านั้นแล้ว
#    ทุกอย่างเข้าผ่าน container นี้ตัวเดียว
#
#  ── เรื่อง hostname ─────────────────────────────────────────
#  ⚠️ ไม่เขียน hostname ไว้ในไฟล์นี้ เพราะ Dokploy เป็นคนจับคู่โดเมน
#     กับ container แล้วส่งต่อ HTTP เข้ามาที่พอร์ต 80 ของเรา
#     ถ้าเขียน hostname ตายตัวไว้ ตอนนี้จะไม่ผ่านจนกว่าจะตรงกันเป๊ะ ๆ
#     (พอร์ต 80 ยังฟังอยู่ เพื่อให้ต่อกับ TLS ที่ proxy ของ Dokploy ได้)
#
#  ── ตารางเส้นทาง ───────────────────────────────────────────
#  /api/*      → api:4000          (Fastify mount ใต้ /api)
#  /auth/*     → api:4000          (Casdoor callback ไม่ได้อยู่ใต้ /api)
#  /docs       → api:4000          (Swagger UI)
#  /docs/*     → api:4000          (css/js/favicon ของ Swagger UI)
#  /files/*    → rustfs-ui:8080    (หน้าไฟล์ใน S3)
#  /logs/*     → loki:3100         (ค้น log)
#  อื่นทั้งหมด → web:3000          (เว็บ Next.js)
#
#  ── สิ่งที่ตั้งใจไม่เปิด ────────────────────────────────────
#  · Carbone Studio (docserver:4000) — ผู้ใช้บอกว่าไม่ได้ใช้
#    มีระบบของเราเองแล้ว และตั้ง `"authentication": false` ไว้ = ไม่มี auth
#  · Alloy UI (alloy:12345) — เป็น SPA ที่ดึง asset จาก **ราก** (`/assets/…`)
#    พอย้ายไปใต้ prefix มันจะขอ asset ผิดที่ (ชนกับ `/_next` ของเว็บ)
#    จึงปล่อยไว้ที่ 127.0.0.1:12345 เหมือนเดิม เข้าผ่าน SSH tunnel ได้
#  · MongoDB / NATS / Valkey / RustFS — ข้อมูล ไม่ใช่หน้าเว็บ
# ─────────────────────────────────────────────────────────────

{
	# Dokploy เป็นคนจัดการ TLS แล้วส่งต่อมาเป็น HTTP
	# → บอก Caddy ว่าข้างนอกเป็น https เพื่อไม่ให้ redirect ผิดและไม่ให้ลองยกอัตโนมัติ
	auto_https off
}

:80 {
	log {
		output stdout
		format console
		level INFO
	}

	# ให้ Dokploy / เครื่องมือตรวจ health ได้ โดยไม่ไปกวนเว็บ
	handle /healthz {
		respond "ok" 200
	}

	# ── API ─────────────────────────────────────────────────
	# ใช้ `handle` ไม่ใช่ `handle_path` เพราะ Fastify คาดว่าจะได้ path เต็ม
	#   ถ้าใช้ handle_path จะถอด `/api` ออก → 404 ทุก route
	handle /api/* {
		reverse_proxy api:4000 {
			# เรนเดอร์ใช้เวลาไม่กี่วินาที แต่ตั้งเผื่อไว้เพื่อไม่ให้ proxy ตัดก่อน
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Casdoor callback ไม่ได้อยู่ใต้ prefix /api → ต้องแยกอีกเส้นทางหนึ่ง
	# (ถ้าลืม ผู้ใช้กด "เข้าสู่ระบบ" แล้วจะได้ 404 จาก Next)
	handle /auth/* {
		reverse_proxy api:4000
	}

	# เอกสาร API เปิดได้โดยไม่ต้องจำพอร์ต
	# ⚠️ ต้อง match ทั้ง `/docs` และ `/docs/*` ไม่งั้นไฟล์ชั้นในจะตกไปโดนเว็บ
	#   หน้า Swagger UI ดึงอีก 7 ไฟล์จาก `/docs/static/…` (css/js/favicon)
	#   ถ้า match แค่ `/docs` พวกนั้นจะหลุดไปจบที่ catch-all ด้านล่าง → 404
	#   (เจอตอนผ่าน gateway: HTML 200 แต่ static 404 ทั้งหมด)
	#
	# ⚠️ ต้องใช้ named matcher เพราะ `handle` รับ path matcher ได้แค่ตัวเดียว
	#   (`handle /docs /docs/* { }` ทำให้ caddy validate ไม่ผ่าน — เจอตอนลองจริง)
	#   และไม่ใช้ `/docs*` เพราะจะไปจับ `/docsomething` ไปด้วย
	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy api:4000
	}
	handle /openapi.json {
		reverse_proxy api:4000
	}

	# ── หน้าไฟล์ใน S3 ──────────────────────────────────────
	# ใช้ `handle_path` เพราะ rclone เสิร์ฟจากราก ไม่รู้จัก prefix
	#   วัดแล้วว่า rclone สร้างลิงก์**สัมพัทฤ์** (`documents/`, `demo/`)
	#   เบราว์เซอร์จึงต่อจาก URL ที่มี prefix ให้เองโดยไม่ต้องแก้ HTML
	redir /files /files/ 301
	handle_path /files/* {
		reverse_proxy rustfs-ui:8080
	}

	# ── ค้น log ─────────────────────────────────────────────
	# Loki เป็น HTTP API ล้วน (ไม่ใช่หน้าเว็บ) จึงถอด prefix ได้ตรง ๆ
	#   /logs/ready              → /ready
	#   /logs/loki/api/v1/labels → /loki/api/v1/labels
	redir /logs /logs/ 301
	handle_path /logs/* {
		reverse_proxy loki:3100
	}

	# ── เว็บ ───────────────────────────────────────────────
	# ต้องอยู่ท้ายสุด: ทุกอย่างที่ไม่ match ข้างบนจะมาตกที่นี่
	handle {
		reverse_proxy web:3000
	}
}

# ─────────────────────────────────────────────────────────────
#  คำเตือนเรื่องความปลอดภัยของ 2 เส้นทางนี้
#
#  ⚠️ `/files` และ `/logs` เปิด**ไม่มีการยืนยันตัวตน** เพราะ:
#     · rustfs-ui  = rclone serve http ไม่มี auth เลย
#     · Loki       = ตั้ง auth_enabled: false
#    เปิดบนโดเมนสาธารณะแล้วใครก็ดูไฟล์ใน S3 และค้น log ได้
#
#  ถ้าต้องการปิดบังค์ ให้ uncomment ด้านล่าง (ต้องเตรียม bcrypt hash ก่อน:
#  `docker run --rm caddy:2 caddy hash-password --plaintext 'รหัสผ่าน'`)
#
#  handle /files* {
#  	basic_auth {
#  		ops ADMIN_HASH_HERE
#  	}
#  	reverse_proxy rustfs-ui:8080
#  }
#
#  ทางเลือกที่ปลอดภัยกว่า: ไม่เปิดสองเส้นทางนี้ ใช้การเข้าเว็บธรรมดาอย่างเดียว
# ─────────────────────────────────────────────────────────────

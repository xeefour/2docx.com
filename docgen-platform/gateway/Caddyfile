# ─────────────────────────────────────────────────────────────
#  ทางเข้าเดียวของทั้งระบบ (reverse proxy)
#
#  เป้าหมาย: ไม่ต้องเปิดพอร์ตออกจากเครื่องเลย ผู้ใช้เข้าผ่านโดเมนเดียว
#    แล้วแยกบริการตาม prefix ของ path
#
#  ทำไมต้องมี: ก่อนหน้านี้ API เปิดที่ 0.0.0.0:4001 และเว็บที่ :3000
#    → ใครใน LAN ก็เรียกได้ ตอนนี้ปิดพอร์ตเหล่านั้นแล้ว
#    ทุกอย่างเข้าผ่าน container นี้ตัวเดียว
#
#  ⚠️ บรรทัด "ปิดพอร์ตแล้ว" เคย**ไม่จริง** ตอนที่เขียน (แก้ 2026-10-05)
#     `next dev` ไม่ได้ใส่ -H → bind ที่ :::3000 · API_HOST=0.0.0.0
#     วัดจริงแล้ว 192.168.100.200:3000 และ 100.77.216.111:3000 (Tailscale) ตอบ 200
#     แก้เป็น 127.0.0.1 ทั้งคู่แล้ว — ดู README.md → "พอร์ตบน host ผูก loopback"
#     ตรวจซ้ำได้ด้วย: node logs/check-no-lan-exposure.mjs
#
#  ── เรื่อง hostname ─────────────────────────────────────────
#  ⚠️ ไม่เขียน hostname ไว้ในไฟล์นี้ เพราะ Dokploy เป็นคนจับคู่โดเมน
#     กับ container แล้วส่งต่อ HTTP เข้ามาที่พอร์ต 80 ของเรา
#     ถ้าเขียน hostname ตายตัวไว้ ตอนนี้จะไม่ผ่านจนกว่าจะตรงกันเป๊ะ ๆ
#     (พอร์ต 80 ยังฟังอยู่ เพื่อให้ต่อกับ TLS ที่ proxy ของ Dokploy ได้)
#
#  ── ตารางเส้นทาง ───────────────────────────────────────────
#  /api/*      → api:4000          (Fastify mount ใต้ /api)
#  /auth/*     → api:4000          (Casdoor callback ไม่ได้อยู่ใต้ /api)
#  /apis       → api:4000          (Swagger UI)
#  /apis/*     → api:4000          (css/js/favicon ของ Swagger UI)
#  /docs/*     → ตัวเอง             (คู่มือ Carbone ภาษาไทย, static file_server)
#  /files/*    → rustfs-ui:8080    (หน้าไฟล์ใน S3)
#  /logs/*     → loki:3100         (ค้น log)
#  /analyze/*  → log-analyzer:3110(หน้าเว็บวิเคราะห์ log ด้วย AI)
#  อื่นทั้งหมด → web:3000          (เว็บ Next.js)
#
#  ── สิ่งที่ตั้งใจไม่เปิด ────────────────────────────────────
#  · Carbone Studio (docserver:4000) — ผู้ใช้บอกว่าไม่ได้ใช้
#    มีระบบของเราเองแล้ว และตั้ง `"authentication": false` ไว้ = ไม่มี auth
#  · Alloy UI (alloy:12345) — เป็น SPA ที่ดึง asset จาก **ราก** (`/assets/…`)
#    พอย้ายไปใต้ prefix มันจะขอ asset ผิดที่ (ชนกับ `/_next` ของเว็บ)
#    จึงปล่อยไว้ที่ 127.0.0.1:12345 เหมือนเดิม เข้าผ่าน SSH tunnel ได้
#  · MongoDB / NATS / Valkey / RustFS — ข้อมูล ไม่ใช่หน้าเว็บ
# ─────────────────────────────────────────────────────────────
{
	# Dokploy เป็นคนจัดการ TLS แล้วส่งต่อมาเป็น HTTP
	# → บอก Caddy ว่าข้างนอกเป็น https เพื่อไม่ให้ redirect ผิดและไม่ให้ลองยกอัตโนมัติ
	auto_https off
}

:80 {
	log {
		output stdout
		format console
		level INFO
	}

	# ให้ Dokploy / เครื่องมือตรวจ health ได้ โดยไม่ไปกวนเว็บ
	handle /healthz {
		respond "ok" 200
	}

	# ── API ─────────────────────────────────────────────────
	# ใช้ `handle` ไม่ใช่ `handle_path` เพราะ Fastify คาดว่าจะได้ path เต็ม
	#   ถ้าใช้ handle_path จะถอด `/api` ออก → 404 ทุก route
	handle /api/* {
		reverse_proxy api:4000 {
			# เรนเดอร์ใช้เวลาไม่กี่วินาที แต่ตั้งเผื่อไว้เพื่อไม่ให้ proxy ตัดก่อน
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Casdoor callback ไม่ได้อยู่ใต้ prefix /api → ต้องแยกอีกเส้นทางหนึ่ง
	# (ถ้าลืม ผู้ใช้กด "เข้าสู่ระบบ" แล้วจะได้ 404 จาก Next)
	handle /auth/* {
		reverse_proxy api:4000
	}

	# เอกสาร API เปิดได้โดยไม่ต้องจำพอร์ต
	# ⚠️ ต้อง match ทั้ง `/apis` และ `/apis/*` ไม่งั้นไฟล์ชั้นในจะตกไปโดนเว็บ
	#   หน้า Swagger UI ดึงอีก 7 ไฟล์จาก `/apis/static/…` (css/js/favicon)
	#   ถ้า match แค่ `/apis` พวกนั้นจะหลุดไปจบที่ catch-all ด้านล่าง → 404
	#   (เจอตอนผ่าน gateway: HTML 200 แต่ static 404 ทั้งหมด)
	#
	# ⚠️ ต้องใช้ named matcher เพราะ `handle` รับ path matcher ได้แค่ตัวเดียว
	#   (`handle /apis /apis/* { }` ทำให้ caddy validate ไม่ผ่าน — เจอตอนลองจริง)
	#   และไม่ใช้ `/apis*` เพราะจะไปจับ `/apisomething` ไปด้วย
	@apis path /apis /apis/*
	handle @apis {
		reverse_proxy api:4000
	}
	handle /openapi.json {
		reverse_proxy api:4000
	}

	# ── คู่มือ Carbone ภาษาไทย (static) ───────────────────────
	# เสิร์ฟตรงจากตัว Caddy ไม่ต้องมี container เพิ่มและไม่ต้อง build
	#   โฟลเดอร์ที่เสิร์ฟ = /srv/manual (mount จาก docgen-platform/manual)
	#
	# ⚠️ ต้องใช้ `handle_path` ไม่ใช่ `handle` เพราะไฟล์ในคู่มืออ้างอิงกัน
	#     แบบสัมพัทฤ์ (`assets/manual.css` ไม่มี slash นำหน้า)
	#     `handle_path` ถอด `/docs` ออกก่อนส่งให้ file_server
	#     ถ้าใช้ `handle` ไฟล์จะถูกมองหาที่ `/srv/manual/docs/…` → 404 ทั้งเว็บ
	#
	# ⚠️ `/docs` (ไม่มี slash ท้าย) ไม่ match `/docs/*` → ต้อง redirect ให้เป็น
	#     `/docs/` ก่อน ไม่งั้นพิมพ์ URL ตรง ๆ แล้วได้ 404
	#
	# ⚠️ เส้นทางนี้**ทับ** Swagger UI เดิมที่เคยอยู่ที่ /docs ไป
	#     ตอนนี้ API ตั้ง routePrefix เป็น `/apis` แล้ว (ดู apps/api/src/app.ts)
	#     เอกสาร API จึงย้ายไปอยู่ที่ /apis แทน
	redir /docs /docs/ 301
	handle_path /docs/* {
		root * /srv/manual
		file_server {
			index index.html
		}
		header Cache-Control "public, max-age=300"
	}

	# ── หน้าไฟล์ใน S3 ──────────────────────────────────────
	# ใช้ `handle_path` เพราะ rclone เสิร์ฟจากราก ไม่รู้จัก prefix
	#   วัดแล้วว่า rclone สร้างลิงก์**สัมพัทฤ์** (`documents/`, `demo/`)
	#   เบราว์เซอร์จึงต่อจาก URL ที่มี prefix ให้เองโดยไม่ต้องแก้ HTML
	redir /files /files/ 301
	handle_path /files/* {
		reverse_proxy rustfs-ui:8080
	}

	# ── ค้น log ─────────────────────────────────────────────
	# Loki เป็น HTTP API ล้วน (ไม่ใช่หน้าเว็บ) จึงถอด prefix ได้ตรง ๆ
	#   /logs/ready              → /ready
	#   /logs/loki/api/v1/labels → /loki/api/v1/labels
	redir /logs /logs/ 301
	handle_path /logs/* {
		reverse_proxy loki:3100
	}

	# ── วิเคราะห์ log ด้วย AI ────────────────────────────────
	# log-analyzer เสิร์ฟหน้าเว็บตัวเดียวที่ / และ API ใต้ /api/*
	# ใช้ handle_path ได้ เพราะ index.html ไม่มี asset ภายนอกเลย (self-contained)
	#   → /analyze            → /                  (หน้าเว็บ)
	#   → /analyze/api/status → /api/status
	#
	# ⚠️ มี basic_auth แล้ว (เพิ่ม 2026-10-06) เพราะหน้านี้เปิด log ทั้งหมด
	#    และใช้โควตา AI ของเรา ใครเข้ามาก็ใช้ได้
	#
	# รหัสผ่านมาจาก ANALYZE_AUTH_PASSWORD ใน dokploy-infra/.env เป็นรหัสผ่านธรรมดา
	#   ที่อ่านออกและแก้ได้เอง ไม่ต้องเดาว่าเดิมตั้งอะไรไว้
	#   แต่ Caddy บังคับให้เป็น bcrypt hash → entrypoint.sh แปลงให้ตอน container เริ่ม
	#   แล้วแทนคำว่า PLACEHOLDER (ตัวข้างล่าง) ด้วย hash จริง
	#
	# ⚠️ ห้ามเขียนชื่อ placeholder นี้ไว้ที่อื่นในไฟล์ (รวมถึงในคอมเมนต์)
	#    entrypoint ใช้ sed แทนทุกที่ที่เจอ → hash จะไปโผล่ในคอมเมนต์ด้วย
	# ⚠️ ห้ามเขียน hash ตรงนี้อีก — เคยเขียนแล้วถูก commit ลง git ไป (6 ต.ค.)
	# ⚠️ ถ้าไม่มี ANALYZE_AUTH_PASSWORD entrypoint จะหยุด container ไว้เลย
	#    → ตั้งใจให้ fail เห็นชัด แทนที่จะเปิดหน้านี้ทิ้งไว้โดยไม่มี auth
	redir /analyze /analyze/ 301
	handle_path /analyze/* {
		basic_auth {
			{$ANALYZE_AUTH_USER} ANALYZE_HASH_PLACEHOLDER
		}
		reverse_proxy log-analyzer:3110 {
			# การวิเคราะห์ด้วยโมเดลที่คิดนาน ๆ (effort=high ใช้ ~90 วิ) ต้องไม่ให้ proxy ตัดก่อน
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# ── เว็บ ───────────────────────────────────────────────
	# ต้องอยู่ท้ายสุด: ทุกอย่างที่ไม่ match ข้างบนจะมาตกที่นี่
	handle {
		reverse_proxy web:3000
	}
}

# ─────────────────────────────────────────────────────────────
#  สถานะการยืนยันตัวตนของแต่ละเส้นทาง
#
#  | เส้นทาง     | ยืนยันตัวตน | เพราะอะไร |
#  |---|---|---|
#  | `/analyze`  | ✅ basic_auth (ops) | เพิ่ม 2026-10-06 — เปิด log ทั้งหมด + ใช้โควตา AI |
#  | `/logs`     | ❌ ไม่มี | Loki ตั้ง `auth_enabled: false` |
#  | `/files`    | ❌ ไม่มี | rustfs-ui คือ `rclone serve http` ไม่มี auth เลย |
#
#  ⚠️ ถ้าจะ map โดเมนจริง ต้องปิด `/logs` และ `/files` ด้วย ไม่งั้น
#     ใครก็ดูไฟล์ใน S3 และค้น log ได้โดยไม่ต้องล็อกอิน
#
#  ── ถ้าจะเพิ่ม basic_auth ─────────────────────────────────
#  1. สร้าง hash:
#     docker run --rm caddy:2 caddy hash-password --plaintext 'รหัสผ่าน'
#  2. ใส่ hash ลงในบรรทัด `ops` ข้างล่าง (เขียนทับ ADMIN_HASH_HERE)
#  3. uncomment บล็อกที่ต้องการ
#
#  ⚠️ bcrypt hash ปลอดภัยกว่าจะ commit ลง git
#     (คนที่ได้ hash ไปยังล็อกอินไม่ได้ แต่ยังตั้งรหัสใหม่ออนไลน์ได้)
#     ถ้าเป็นระบบสาธารณะจริง ให้ผูกกับ Casdoor แทน basic_auth
#
#  handle /files* {
#  	basic_auth {
#  		ops ADMIN_HASH_HERE
#  	}
#  	reverse_proxy rustfs-ui:8080
#  }
#
#  handle /logs* {
#  	basic_auth {
#  		ops ADMIN_HASH_HERE
#  	}
#  	handle_path * {
#  		reverse_proxy loki:3100
#  	}
#  }
#
#  ทางเลือกที่ปลอดภัยกว่า: ไม่เปิดสองเส้นทางนี้บนโดเมนสาธารณะ
#  ให้เข้าได้เฉพาะ 127.0.0.1 (ผูก loopback) หรือผ่าน SSH tunnel
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
#  เปลี่ยนรหัสผ่านของ /analyze
#
#  1. สร้าง hash ใหม่:
#     docker run --rm caddy:2 caddy hash-password --plaintext 'รหัสผ่านใหม่'
#
#  2. แทน hash เดิมในบล็อก `handle_path /analyze/*` ด้านบน
#
#  3. บังคับให้ใช้ hash ใหม่ทันที (hash เก่ายังใช้ได้จนกว่าจะ reload):
#     cd D:\2docx.com\dokploy-infra
#     docker compose restart gateway
#
#  ผู้ใช้ชื่อ `ops` · ถ้าอยากเปลี่ยนชื่อผู้ใช้ แก้คำว่า ops ในบล็อกเดียวกัน
# ─────────────────────────────────────────────────────────────

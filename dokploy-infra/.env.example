# ── copy เป็น .env แล้วเติมค่าจริง — ห้าม commit ──
# .env ถูก .gitignore ไว้แล้ว
#
# ⚠️ ไฟล์นี้คือ env ของ**ทั้งระบบ** (ตั้งแต่ 2026-10-05 ที่รวมสอง stack เข้าด้วยกัน)
#    docker compose อ่านค่าจากไฟล์ที่อยู่โฟลเดอร์เดียวกับ docker-compose.yml
#    เท่านั้น ย้ายไฟล์ compose ไปที่อื่น = ค่าทั้งหมดนี้กลายเป็นค่าว่าง
#    และ container api/worker จะ crash ตอน boot
#
# ⚠️ password ต้องขึ้นต้นด้วยตัวอักษร ห้ามขึ้นต้นด้วยตัวเลข
#    (NATS resolve ตัวแปรที่ขึ้นต้นด้วยตัวเลขได้ผิดค่า)
#
# สร้างค่าใหม่:  openssl rand -base64 24

# ── Queue: NATS + JetStream ──
NATS_PASSWORD=
NATS_STREAM=DOCGEN
NATS_SUBJECT=jobs.render

# ── Cache: Valkey ──
VALKEY_PASSWORD=

# ── Object storage: RustFS ──
# ⚠️ S3_ACCESS_KEY / S3_SECRET_KEY คือของชื่อเดียวกันกับ STORAGE_* ข้างบน
#    ต้องเป็นค่าเดียวกันทุกประการ มิฉะนั้น API จะต่อ RustFS ไม่ผ่าน
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PASSPHRASE=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=documents

# ── Database: MongoDB replica set ──
# ใช้ทั้งกับ API และ worker ของ docgen-platform
MONGO_PASSWORD=
MONGO_DB=app

# ── Document server: Carbone ──
DOCSERVER_API_KEY=carbon-ce
DOCSERVER_TIMEOUT_MS=300000

# ── Casdoor SSO (auth เข้าสู่ระบบ) ──
# ⚠️ ไม่มีค่า default ใน schema → ขาดแล้ว container crash ตอน boot ทันที
CASDOOR_ISSUER=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_SCOPES=openid profile email

# ── โดเมนจริง ──────────────────────────────────────────────────
# ⚠️ ทั้ง 3 ค่านี้ยังชี้ localhost — ต้องเปลี่ยนเป็นโดเมนจริงก่อน production
#    และต้องลงทะเบียน redirect URI เดียวกันใน Casdoor ด้วย
CORS_ORIGINS=http://localhost:8090
AUTH_SUCCESS_REDIRECT=http://localhost:3000
CASDOOR_REDIRECT_URI=http://localhost:4001/auth/callback

# ── อื่น ๆ ──
LOG_LEVEL=info
SESSION_COOKIE_NAME=docgen_session
SESSION_TTL=86400
OUTPUT_BRAND=2docx.com

# ── Log Analyzer (หน้า /analyze) ─────────────────────────────────
# ใช้กับปุ่ม "วิเคราะห์ด้วย AI" — ถ้าว่าง UI จะ disable ปุ่มให้เอง
# (ส่วนดูภาพรวม + เหตุการณ์น่าสงสัยยังใช้ได้ตามปกติ เพราะมาจาก Loki โดยตรง)
# ⚠️ /analyze มี basic_auth ที่ gateway ตั้งไว้ (ดู docgen-platform/gateway/Caddyfile)
#    แต่ตัว service เองไม่มี auth และไม่ publish พอร์ตออกมา
#    ถ้าวันไหนแก้ Caddyfile แล้วลบ basic_auth ทิ้ง ให้รีบเพิ่มกลับ ไม่งั้นใครก็อ่าน log ได้
MINIMAX_API_KEY=
# ปล่อยว่างไว้ = ใช้ endpoint สาธารณะ https://api.minimax.io/anthropic/v1
MINIMAX_BASE_URL=

# ── รหัสผ่านเข้า /analyze (Caddy basic_auth) ─────────────────────────
# เพิ่ม 2026-10-07 — เดิมฝัง bcrypt hash ไว้ตรงใน Caddyfile ซึ่งถูก commit ลง git
#   แล้ว hash เก็บกลับไม่ได้ (bcrypt เป็นทางเดียว) = ไม่มีทางรู้ว่าตั้งอะไรไว้
#   ตอนนี้เก็บรหัสผ่านธรรมดาที่อ่านออกได้แทน แล้วให้ gateway/entrypoint.sh
#   แปลงเป็น hash ตอน container เริ่มทำงาน (Caddy รับเฉพาะ hash เท่านั้น)
#
# แก้ค่านี้แล้วต้องสั่ง restart ถึงจะมีผล:
#   cd dokploy-infra
#   docker compose -f docker-compose.yml -f docker-compose.dev-ports.yml up -d gateway
#
# ⚠️ ถ้าว่างหรือลบบรรทัดนี้ container จะหยุดตอน start (ไม่ใช่เปิดหน้า /analyze
#    ทิ้งไว้แบบไม่มี auth) → ตั้งใจให้ fail เห็นชัด
ANALYZE_AUTH_USER=ops
ANALYZE_AUTH_PASSWORD=เปลี่ยนรหัสนี้
# ชื่อ compose project ที่หน้า /analyze รายงาน (ตัวกรอง dropdown + digest)
# ต้องตรงกับ regex ใน observability/alloy/config.alloy — ถ้าเปลี่ยนฝั่งหนึ่ง
# ต้องเปลี่ยนอีกฝั่งด้วย ไม่งั้น UI จะโชว์ชื่อที่ไม่มี log หรือมองของตัวเองไม่เห็น
# เว้นว่าง = ไม่กรอง (ดูทุก stream บนเครื่อง — ใช้ตอน debug เท่านั้น)
COMPOSE_PROJECT=dokploy-infra

# ── Cloudflare Tunnel ──
# Zero Trust > Networks > Tunnels > (tunnel ของคุณ) > Configure
# รูปแบบ: eyJhIjoiXXXXX...
# ว่างไว้ = cloudflared ไม่ขึ้น (อยู่ใต้ profile "tunnel") ไม่กระทบ service อื่น
CF_TUNNEL_TOKEN=

# ═══════════════════════════════════════════════════════════════════
#  ค่าเฉพาะตอน dev บน host (รัน `npm run dev` ใน docgen-platform)
#
#  ไฟล์นี้คือ**ไฟล์เดียวของทั้งโปรเจกต์** — ค่าลับและค่า Docker อยู่ข้างบน
#  ย้ายค่าชุดนี้เข้ามาเมื่อ 2026-10-06 จาก docgen-platform/.env
#
#  ⚠️ ค่าชุดนี้ชี้เข้า **host เอง** (127.0.0.1) ต่างจากค่าใน container
#     ซึ่งชี้ชื่อ service บนเครือข่าย Docker · docker-compose.yml ประกอบ URL
#     เองจากรหัสผ่านข้างบน ไม่ได้อ่านจากตรงนี้
#
#  ⚠️ รหัสผ่านใน URL ต้องตรงกับ NATS_PASSWORD / VALKEY_PASSWORD / MONGO_PASSWORD
#     ข้างบน — ไฟล์ .env ไม่รองรับการอ้างค่าข้ามตัวแปร จึงต้องแก้สองที่
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=development
# ใน container ตั้งเป็น 0.0.0.0 ที่ docker-compose.yml ให้แล้ว
API_HOST=127.0.0.1
API_PORT=4001

# ── MongoDB ───────────────────────────────────────────────────
# ตอนรันบน host ต้องหา primary จริงก่อน ไม่งั้นจะไปต่อ node ที่เป็น secondary
MONGO_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/app?directConnection=true&authSource=admin
MONGO_INIT_URL=mongodb://docgen:CHANGE_ME@127.0.0.1:27017/admin?directConnection=true
MONGO_PRIMARY_CANDIDATES=127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019

# ── Valkey (cache) ────────────────────────────────────────────
VALKEY_URL=redis://:CHANGE_ME@127.0.0.1:16379

# ── NATS JetStream (คิวงาน) ───────────────────────────────────
NATS_URL=nats://app:CHANGE_ME@127.0.0.1:4222

# ── RustFS (เก็บไฟล์) ─────────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
# presigned URL ต้องชี้จุดที่ client เข้าถึงได้ ไม่ใช่ localhost ของเรา
# ถ้าเรียกผ่าน Tailscale/Cloudflare แล้วเว้นว่างไว้ ลิงก์ดาวน์โหลดจะพัง
S3_PUBLIC_ENDPOINT=

# ── docserver (เรนเดอร์ PDF) ──────────────────────────────────
# ใน container ตั้งเป็น http://docserver:4000 ที่ docker-compose.yml ให้แล้ว
DOCSERVER_URL=http://127.0.0.1:4000
# presigned URL ต้องชี้ที่จุดที่ client เข้าถึงได้ ไม่ใช่ localhost ของเรา
# ตั้งตอนเข้าผ่าน Tailscale Serve / Cloudflare Tunnel

# ── cookie ───────────────────────────────────────────────────
# ต้องเป็น true เมื่อเสิร์ฟผ่าน https (browser ปฏิเสธ cookie Secure=false บน https)
SESSION_COOKIE_SECURE=false

# ── ผู้ช่วย AI ในหน้าแก้ไขแม่แบบ (สัมภาษณ์ผู้ใช้ → เติมค่าในฟอร์ม) ───────
# ⚠️ ค่าชุดนี้ต้องอยู่ในไฟล์นี้ด้วย มิฉะนั้น compose จะไม่ส่งเข้า container
#   แล้ว LLM_PROVIDER ตกไปใช้ค่าเริ่มต้น `mock` → AI เดาจากชื่อฟิลด์ ไม่ได้คิดจริง
# mock = ไม่ยิงเครือข่าย (ใช้ตอนอยากปิด AI ชั่วคราว) · openai = endpoint แบบ OpenAI
LLM_PROVIDER=mock
# เว้นว่าง = ใช้ MINIMAX_API_KEY ข้างบนอัตโนมัติ
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
# เว้นว่าง = ใช้ base URL เริ่มต้นของ provider (minimax → https://api.minimax.io/v1)
LLM_BASE_URL=
# ปิดการ "คิด" ก่อนตอบ — การสัมภาษณ์ถาม-ตอบสั้น ๆ ไม่ต้องคิดยาว
LLM_THINKING=disabled
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# ── ผู้รับรายงานปัญหาจากผู้ใช้ ─────────────────────────────────
# ผู้ใช้เจอปัญหาแล้วกด "รายงานปัญหา" (แถบ URL มุมล่างซ้าย) รายงานจะเข้ากล่องจดหมาย
# ของทุกคนที่ sub อยู่ในรายชื่อนี้ ค่า sub คือค่าจาก Casdoor
#
# ⚠️ เว้นว่าง = ปิดฟีเจอร์นี้ทั้งหมด (ปุ่มไม่โผล่ และหน้า /reports ตอบ 404 ทุกคน)
# ⚠️ ใส่หลายคนคั่นด้วย `,` · ผู้ส่งรายงาน**ไม่ต้อง**อยู่ในรายชื่อนี้
#    (จำกัดผู้ส่ง = ผู้ใช้ที่เจอปัญหาจริงพึ่งทางลัดไม่ได้ ปัญหาจะถูกเก็บไว้เงียบ ๆ)
REPORT_TO_SUBS=